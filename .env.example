# LLM
ANTHROPIC_API_KEY=sk-ant-xxx
# 可选：兼容 OpenAI 格式的中转/国产模型时填写
# ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL=claude-sonnet-5

# Agent
MAX_STEPS=12
CONTEXT_TOKEN_BUDGET=24000

# Storage
DB_PATH=./data/saiclawbot.db

# Telegram (可选)
TELEGRAM_BOT_TOKEN=
# 逗号分隔的允许使用的 user_id 白名单，空则拒绝所有人
ALLOWED_USER_IDS=
