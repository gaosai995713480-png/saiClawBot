# LLM：默认使用 OpenCode Go 的 DeepSeek V4 Flash
ANTHROPIC_API_KEY=
# Anthropic Python SDK 会自行补上 /v1/messages，程序会自动规范化带 /v1 的地址。
ANTHROPIC_BASE_URL=https://opencode.ai/zen/go/v1
MODEL=deepseek-v4-flash

# Agent
MAX_STEPS=12
CONTEXT_TOKEN_BUDGET=24000

# Storage
DB_PATH=./data/saiclawbot.db

# Telegram (可选)
TELEGRAM_BOT_TOKEN=
# 逗号分隔的允许使用的 user_id 白名单，空则拒绝所有人
ALLOWED_USER_IDS=
